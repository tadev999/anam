rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Quyền cho các bài viết ẩn danh trong Khoảng Buông / Bếp Lửa Chung
    match /releases/{releaseId} {
      allow read, create: if true; // Bất kỳ ai cũng có thể đọc và viết bài ẩn danh
      allow update: if request.auth != null; // Yêu cầu đăng nhập để gửi "cái ôm ảo" (tăng hugCount)
    }
    
    // Quyền riêng tư cho thông tin cá nhân và Điểm Neo mỗi ngày của từng user
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /anchors/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
